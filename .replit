modules = ["nix", "python-3.14", "nodejs-24"]
[agent]
expertMode = true

[nix]
channel = "stable-25_05"
packages = ["openssl", "uv", "nano", "gnupg"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start Application"

[[workflows.workflow]]
name = "Start Application"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bun dev"

[deployment]
deploymentTarget = "autoscale"
run = ["bun", "run", "dev"]

[[ports]]
localPort = 5173
externalPort = 80
exposeLocalhost = true
