{
  "name": "getlib",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Open-source self-hosted developer knowledge platform - version-aware, provenance-aware.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/D1ZZY4/getlib.git"
  },
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --cwd apps/dashboard dev",
    "build": "turbo run build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "ci": "bun run lint && bun run typecheck && bun run test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "turbo": "^2.11.2",
    "typescript": "^6.0.3"
  }
}
