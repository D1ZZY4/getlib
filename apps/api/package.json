{
  "name": "@getlib/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "GetLib HTTP API boundary (Hono + Zod, contract-driven, OpenAPI). Transport only; business logic lives in shared packages.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "src"
  ],
  "scripts": {
    "dev": "bun run src/index.ts",
    "start": "bun run src/index.ts",
    "lint": "biome check src",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "build": "bun build src/index.ts --outdir dist --target bun"
  },
  "dependencies": {
    "@getlib/config": "workspace:*",
    "@getlib/schemas": "workspace:*",
    "@hono/zod-openapi": "^1.6.3",
    "@scalar/hono-api-reference": "^0.12.4",
    "hono": "^4.13.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  }
}
