# GetLib - local environment baseline (Phase 1)
# Copy to .env for local development. Never commit .env.

NODE_ENV=development
LOG_LEVEL=info
LOG_FORMAT=text

# PostgreSQL + pgvector (see compose.yml)
DATABASE_URL=postgres://getlib:getlib@localhost:5432/getlib

# API (Phase 3 placeholder - not yet implemented)
API_PORT=3001
API_BASE_URL=http://localhost:3001

# Dashboard dev (Vite)
VITE_API_BASE_URL=http://localhost:3001/api/v1
